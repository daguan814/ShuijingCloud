# ShuijingCloud runtime configuration
APP_HOST=0.0.0.0
APP_PORT=8080
TZ=Asia/Shanghai

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=shuijing_cloud
DB_PASSWORD=replace-with-a-strong-password
DB_NAME=ShuijingCloud

STORAGE_ROOT=/data/storage
RECYCLE_ROOT=/data/storage/回收站
LOG_DIR=/data/logs
MAX_CONTENT_LENGTH=10737418240

SECRET_KEY=replace-with-a-long-random-string
RECYCLE_BIN_PASSWORD=replace-with-a-recycle-password

TLS_CERT=/certs/shuijing.site.crt
TLS_KEY=/certs/shuijing.site.key

ALLOWED_ORIGINS=http://127.0.0.1:5173
